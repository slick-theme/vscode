  "semanticTokenColors": {
    "variable": "#543e56",
    "parameter": "#543e56",
    "property": "#392d3b",
    "function": "#c59f00",
    "method": "#c59f00",
    "class": "#598d00",
    "interface": "#598d00",
    "type": "#598d00",
    "typeParameter": "#598d00",
    "enum": "#357bef",
    "enumMember": "#357bef",
    "namespace": "#598d00",
    "macro": "#cd37e2",
    "keyword": "#cd37e2",
    "comment": "#d6b4db",
    "string": "#008ba3",
    "number": "#e93e3f",
    "regexp": "#009164",
    "operator": "#875e8c"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#d6b4db"
      }
    },
    {
      "name": "Doc comments",
      "scope": [
        "comment.block.documentation",
        "comment.block.javadoc"
      ],
      "settings": {
        "foreground": "#009164"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#008ba3"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#009164"
      }
    },
    {
      "name": "Escapes",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#e93e3f"
      }
    },
    {
      "name": "Numbers and booleans",
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#e93e3f"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant",
        "constant.language",
        "constant.other",
        "variable.other.constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#357bef"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#cd37e2"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#875e8c"
      }
    },
    {
      "name": "Preprocessor",
      "scope": [
        "meta.preprocessor",
        "keyword.control.directive",
        "punctuation.definition.directive"
      ],
      "settings": {
        "foreground": "#cd37e2"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#c59f00"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#598d00"
      }
    },
    {
      "name": "Enums and variants",
      "scope": [
        "entity.name.type.enum",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#357bef"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "meta.tag"
      ],
      "settings": {
        "foreground": "#598d00"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#392d3b"
      }
    },
    {
      "name": "Labels",
      "scope": [
        "entity.name.label"
      ],
      "settings": {
        "foreground": "#009164"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.parameter",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#543e56"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#392d3b"
      }
    },
    {
      "name": "this and self",
      "scope": [
        "variable.language"
      ],
      "settings": {
        "foreground": "#357bef"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#875e8c"
      }
    },
    {
      "name": "Special punctuation",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#c59f00"
      }
    },
    {
      "name": "Headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#cd37e2"
      }
    },
    {
      "name": "Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#008ba3",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#008ba3",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Inline code",
      "scope": [
        "markup.inline.raw",
        "markup.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#008ba3"
      }
    },
    {
      "name": "Links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#008ba3"
      }
    },
    {
      "name": "Link text",
      "scope": [
        "string.other.link.title",
        "meta.link.inline"
      ],
      "settings": {
        "foreground": "#357bef"
      }
    },
    {
      "name": "Quotes and lists",
      "scope": [
        "markup.quote",
        "punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#875e8c"
      }
    },
    {
      "name": "Inserted and deleted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#69a500"
      }
    },
    {
      "name": "Deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#ef4444"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ef4444"
      }
    }
  ]
}